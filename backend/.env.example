# ORCA Backend Environment Variables

# LLM
GEMINI_API_KEY=your_gemini_api_key_here

# Weather (optional - Open-Meteo needs no key)
OPENWEATHER_API_KEY=

# Guardian
GUARDIAN_ENABLED=true
GUARDIAN_INTERVAL_SECONDS=300

# Demo mode (true = use fixture data, false = live APIs)
DEMO_MODE=false

# JWT
JWT_SECRET=orca_secret_key_change_in_production_2026
JWT_ALGORITHM=HS256

# Marine API (Open-Meteo is default, no key needed)
MARINE_API_URL=https://marine-api.open-meteo.com/v1/marine
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# IMD warning feed (optional)
IMD_FEED_URL=

# CORS
FRONTEND_URL=http://localhost:3000

# ── LLM ──────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Marine / Weather (Open-Meteo — no key needed) ────────────────────────────
MARINE_API_URL=https://marine-api.open-meteo.com/v1/marine
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# ── Guardian ──────────────────────────────────────────────────────────────────
GUARDIAN_ENABLED=true
GUARDIAN_INTERVAL_SECONDS=300        # Use 15 for dev/demo

# ── Demo mode ─────────────────────────────────────────────────────────────────
DEMO_MODE=false                      # true = use fixture data

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_in_production_orca_2026
JWT_ALGORITHM=HS256

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Optional feeds ────────────────────────────────────────────────────────────
IMD_FEED_URL=
OPENWEATHER_API_KEY=

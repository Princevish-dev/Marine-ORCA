# Working prototype (no login auth). Run with local Ollama.
OLLAMA_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b

OPENWEATHER_API_KEY=

GUARDIAN_ENABLED=true
GUARDIAN_INTERVAL_SECONDS=300

# false = working mode (live Open-Meteo marine/weather). true = offline demo fixtures.
DEMO_MODE=false
APP_ENV=development

JWT_SECRET=
JWT_ALGORITHM=HS256

MARINE_API_URL=https://marine-api.open-meteo.com/v1/marine
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

IMD_FEED_URL=https://mosdac.gov.in/isrocast.xml

FRONTEND_URL=http://localhost:3000

ISRO_DATA_DIR=data/isro

NEXT_PUBLIC_API_URL=http://localhost:8000
